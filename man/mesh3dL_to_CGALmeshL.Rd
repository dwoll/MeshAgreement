\name{mesh3dL_to_CGALmeshL}
\alias{mesh3dL_to_CGALmeshL}
\title{Turns an observer / mesh list of mesh3d objects into an observer / mesh list of CGALmesh objects}
\description{Utility function that turns an observer / mesh list of mesh3d objects (from package rgl) into an observer / mesh list of CGALmesh objects (from package MeshUtils).}
\usage{
mesh3dL_to_CGALmeshL(x)
}
\arguments{
  \item{x}{\code{list} of \code{list}s of meshes as generated by \code{\link[MeshAgreement]{read_mesh}}.}
}
\details{Each mesh in the supplied list is assigned to a different observer. As a result, there will be as many observers as meshes, each observer with one mesh.}
\value{\code{list} of observer / mesh objects as generated by \code{\link[MeshAgreement]{read_mesh}}.}
\seealso{
\code{\link[MeshAgreement]{read_mesh}}
}
\examples{
heartL <- mesh3dL_to_CGALmeshL(data_heart_obsL)
get_mesh_info_one(heartL[["Obs01"]][["Obs01_HEART"]])
}
